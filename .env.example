# ==============================================================
# Cau hinh RAG Chatbot - He thong ho tro sua chua dien tu
# ==============================================================

# 1. Thong tin ung dung chung
APP_NAME=appliance-troubleshooter-rag
APP_ENV=development
DEBUG=True

# 2. Cau hinh Neo4j (Knowledge Graph - do thi tri thuc)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# 3. Cau hinh ChromaDB (Vector Store - tim kiem ngu nghia)
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_COLLECTION_NAME=electronics_knowledge

# 4. Cau hinh Embedding Model
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# 5. Cau hinh Local LLM (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=qwen2.5:7b

# 6. Cau hinh SQLite & Phien dang nhap
SQLITE_DB_PATH=data/chat_history.db
SESSION_EXPIRE_DAYS=7
SESSION_SECRET_KEY=change-this-secret-in-production

# 7. Cau hinh SMTP gui email & Khoi phuc mat khau
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@ragchatbot.local
SMTP_USE_TLS=True
# URL giao dien nguoi dung Chainlit (bat buoc dat port 8001 de link dat lai mat khau trong email tro dung trang reset)
FRONTEND_BASE_URL=http://localhost:8001
PASSWORD_RESET_EXPIRE_MINUTES=15
PASSWORD_RESET_RATE_LIMIT_COUNT=3
PASSWORD_RESET_RATE_LIMIT_MINUTES=15

# 8. Cau hinh Chainlit UI
CHAINLIT_AUTH_SECRET=change-this-chainlit-auth-secret-in-production
CHAINLIT_PORT=8001
API_PORT=8000


